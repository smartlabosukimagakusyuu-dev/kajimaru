# Firebaseコンソール →（歯車）プロジェクトの設定 → マイアプリ → ウェブアプリ の firebaseConfig の値。
# このファイルを .env.local という名前でコピーして、値を入れてください。
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# AdMob → アプリ → 広告ユニット の「下部バナー」のID（本番用。開発中はテスト広告を使う）
EXPO_PUBLIC_ADMOB_BANNER_ID=

# google-services.json の oauth_client で client_type が 3 のもの（スマホ版のGoogleログインに使う）
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
